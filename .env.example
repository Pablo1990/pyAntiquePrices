OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_NUM_CTX=8192

DATABASE_URL=sqlite:///./data/antiquegpt.db

BASE_CURRENCY=EUR

TOP_K_COMPARABLES=20
MIN_SIMILARITY=0.05
MAX_SALE_AGE_YEARS=80
MIN_DATA_QUALITY_SCORE=0.4
MIN_COMPARABLES_FOR_MODEL=6
MIN_COMPARABLES_FOR_CONFIDENCE=10

ENABLE_IMAGE_EMBEDDINGS=false
SEMANTIC_WEIGHT=0.50
VISUAL_WEIGHT=0.30
STRUCTURED_WEIGHT=0.20

PRICE_TARGET=normalized_realized_price

# eBay developer API – used by `scripts/scrape_sales.py --sources ebay_api`
# Create a keyset at https://developer.ebay.com/my/keys
# App ID (Client ID)
EBAY_CLIENT_ID=
# Cert ID (Client Secret). The Dev ID is not needed.
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_ES
# production | sandbox
EBAY_ENVIRONMENT=production
# 20081 = Antiques; leave empty to search all categories
EBAY_CATEGORY_IDS=20081

# Show live eBay listings next to each appraisal (fetched per query, never stored)
EBAY_LIVE_LISTINGS=true
EBAY_LIVE_MAX_RESULTS=10
# active = current listings (asking prices); sold = needs Marketplace Insights approval
EBAY_LIVE_MODE=active
